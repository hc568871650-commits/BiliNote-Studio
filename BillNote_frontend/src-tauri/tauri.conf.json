{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BiliNote Studio",
  "mainBinaryName": "BiliNoteStudio",
  "version": "0.1.0-preview.8",
  "identifier": "com.bilinote.studio.full",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3015",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build --mode tauri "
  },
  "app": {
    "windows": [
      {
        "title": "BiliNote Studio",
        "width": 1600,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "externalBin": [
      "bin/BiliNoteBackend/BiliNoteBackend"
    ],
    "resources": {
    "bin/BiliNoteBackend/_internal":"_internal"
    },
    "macOS":{
      "files": {
               "Frameworks": "bin/BiliNoteBackend/_internal"
      }
    },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/studio.ico",
      "icons/studio.png"
    ]
  }
}
